# ─────────────────────────────────────────────────────────────────────────────
# MPORTANT: These variables control the Docker container, NOT the
# cowrie internal configuration. For hostname, credentials, telnet, etc.
# edit cowrie/etc/cowrie.cfg (see cowrie.cfg.example included)
# ─────────────────────────────────────────────────────────────────────────────

# ── Image ───────────────────────────────────────────────────────────────────
COWRIE_VERSION=latest

# ── Container ───────────────────────────────────────────────────────────────
CONTAINER_NAME=cowrie
RESTART_POLICY=unless-stopped

# ── HOST PORTS ─────────────────────────────────────────────────────────
# Host port that maps to the SSH honeypot (internal: 2222)
# If the host already uses :22 for real SSH, move it to another port first
SSH_HOST_PORT=2222

# Host port that maps to the Telnet honeypot (internal: 2223)
TELNET_HOST_PORT=2223

# ── System time ──────────────────────────────────────────────────────────────────
TZ=Europe/Madrid

# ── Container logging (Docker, not cowrie) ────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
